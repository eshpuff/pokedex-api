# Porta em que a API vai rodar
PORT=3000

# String de conexão do MongoDB
# Local:  mongodb://localhost:27017/pokedex
# Atlas:  mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/pokedex?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pokedex

# Segredo usado para assinar o JWT (use um valor longo e aleatório)
JWT_SECRET=estou-louca-por-pokopia

# Tempo de expiração do token
JWT_EXPIRES_IN=1d

# URL base da PokéAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
